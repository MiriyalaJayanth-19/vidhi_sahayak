# ───────────────────────────────────────────────
# VidhiSahayak Backend — Environment Variables
# Copy to .env and fill in your actual values.
# ───────────────────────────────────────────────

# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ── MongoDB ─────────────────────────────────────
# Local:   mongodb://localhost:27017/vidhisahayak
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vidhisahayak
MONGODB_URI=mongodb://localhost:27017/vidhisahayak

# ── Redis (Rate Limiter) ─────────────────────────
# Leave empty in local dev to fall back to in-memory rate limiting.
# Set for production to share limits across replicas.
# Local Docker: redis://localhost:6379
REDIS_URL=

# ── JWT ─────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── AI Providers ────────────────────────────────
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=

# ── CORS ────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── Monitoring ──────────────────────────────────
# Leave empty to disable Sentry error reporting.
# Get DSN at: https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
