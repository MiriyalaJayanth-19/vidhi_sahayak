# ───────────────────────────────────────────────
# VidhiSahayak Backend — Environment Variables
# Copy to .env and fill in your actual values.
# ───────────────────────────────────────────────

# ── Server ──────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────
# Local:   mongodb://localhost:27017/vidhisahayak
# Atlas:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vidhisahayak
MONGODB_URI=mongodb://localhost:27017/vidhisahayak

# ── JWT ─────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── AI Providers ────────────────────────────────
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=

# ── CORS ────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
