# ── AI Chat (required for full AI responses) ──────────────────────────────────
# Primary provider. Without it, the chat falls back to a static helper reply.
GEMINI_API_KEY=

# ── Supabase (optional) ───────────────────────────────────────────────────────
# Enables auth, dashboards, chat history and document saving. The app runs
# without these — protected routes stay open and data is not persisted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Additional AI providers (optional fallbacks) ──────────────────────────────
# Used in order Gemini → Perplexity → OpenAI if the earlier ones fail.
PERPLEXITY_API_KEY=
OPENAI_API_KEY=

# ── Voice / Speech Features ───────────────────────────────────────────────────
# Server-side Google Text-to-Speech for spoken answers (optional).
GOOGLE_TTS_API_KEY=
NEXT_PUBLIC_VOICE_ENABLED=true
