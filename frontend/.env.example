# ──────────────────────────────────────────────────────────────────
# VidhiSahayak Frontend — Environment Variables
# Copy to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────────

# ── Backend API URL ─────────────────────────────────────────────────
# Development: point to your local Express backend
# Production:  your AWS Elastic Beanstalk or ECS service URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api

# ── Voice / Speech Features ────────────────────────────────────────
NEXT_PUBLIC_VOICE_ENABLED=true